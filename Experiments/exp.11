
<!DOCTYPE html>
<html>
<head>
<title>Home Finder</title>
<style>
body {
  font-family: Arial;
  text-align: center;
  background: linear-gradient(135deg,#134e5e,#71b280);
  color: white;
}
h1 { color: #ffe082; }
.card {
  background: #f1fff5;
  color: #234;
  width: 250px;
  padding: 20px;
  margin: 20px auto;
  border-radius: 15px;
}
input {
  padding: 10px;
  margin: 8px;
  width: 80%;
}
button {
  background: #087f5b;
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 8px;
  cursor: pointer;
}
</style>
</head>
<body>

<h1>🏡 HOME FINDER</h1>
<h3>Find Your Dream Property</h3>

<div class="card">
  <h2>Search Property</h2>
  <input id="area" placeholder="Enter Location">
  <input id="budget" type="number" placeholder="Enter Budget">
  <button onclick="search()">Search</button>
  <p id="result"></p>
</div>

<div class="card">
  <h3>Available Property</h3>
  <p>🏠 2BHK House - ₹25,00,000</p>
  <p>🌳 Residential Land - ₹15,00,000</p>
  <p>🏢 Commercial Building - ₹40,00,000</p>
  <button onclick="alert('Property booking request submitted!')">Book Property</button>
</div>

<script>
function search() {
  let area = document.getElementById("area").value;
  let budget = document.getElementById("budget").value;

  if(area && budget) {
    document.getElementById("result").innerHTML =
      "Searching properties in " + area +
      " within ₹" + budget;
  } else {
    alert("Please enter location and budget!");
  }
}
</script>

</body>
</html>
