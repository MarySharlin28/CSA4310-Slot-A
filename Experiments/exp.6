
<!DOCTYPE html>
<html>
<head>
<title>Cake Ordering System</title>
<style>
body{
font-family:Arial;
text-align:center;
background:linear-gradient(120deg,#ffe0e6,#f8bbd0,#fff0db);
margin:0;
}
h1{
background:#8e2454;
color:white;
padding:20px;
}
.box{
background:white;
margin:20px auto;
padding:20px;
width:80%;
max-width:500px;
border-radius:15px;
box-shadow:0 3px 10px #aaa;
}
input,select,button{
padding:10px;
margin:7px;
border-radius:6px;
border:1px solid #ccc;
}
button{
background:#8e2454;
color:white;
cursor:pointer;
}
button:hover{background:#e75480}
</style>
</head>
<body>

<h1>🎂 Online Cake Ordering System</h1>

<div class="box">
<h2>User Login</h2>
<input id="user" placeholder="Username">
<input id="pass" type="password" placeholder="Password">
<button onclick="alert('Login Successful')">Login</button>
</div>

<div class="box">
<h2>Available Cakes</h2>
<select id="cake">
<option>Chocolate Cake - ₹500</option>
<option>Vanilla Cake - ₹400</option>
<option>Black Forest - ₹600</option>
<option>Red Velvet - ₹700</option>
</select>
<select id="size">
<option>Half Kg</option>
<option>1 Kg</option>
<option>2 Kg</option>
</select>
<input id="message" placeholder="Cake Message">
<input id="address" placeholder="Delivery Address">
<button onclick="order()">Order Now</button>
<p id="result"></p>
</div>

<div class="box">
<h2>Admin Panel</h2>
<input id="newcake" placeholder="New Cake Name">
<button onclick="add()">Add Cake</button>
<p id="admin"></p>
</div>

<script>
function order(){
let cake=document.getElementById("cake").value;
let address=document.getElementById("address").value;
if(address){
document.getElementById("result").innerHTML=
"Order Successful! "+cake+"<br>Delivery: "+address;
}else{
alert("Enter delivery address");
}
}
function add(){
let name=document.getElementById("newcake").value;
document.getElementById("admin").innerHTML=
name+" added successfully!";
}
</script>

</body>
</html>
