
<!DOCTYPE html>
<html>
<head>
<title>Ram Infotech</title>
<style>
body{margin:0;font-family:Arial;text-align:center;background:linear-gradient(120deg,#232526,#4776a8)}
header{background:#f4b942;padding:22px;color:#222}
nav{background:#172b4d;padding:15px}
nav a{color:white;margin:12px;text-decoration:none}
.box{background:white;width:80%;margin:25px auto;padding:20px;border-radius:12px}
.item{display:inline-block;background:#eaf1fa;padding:15px;margin:10px;border-radius:10px}
button{background:#286090;color:white;padding:10px 18px;border:0;border-radius:6px;cursor:pointer}
input,textarea{padding:10px;margin:8px;border:1px solid #aaa;border-radius:5px}
</style>
</head>
<body>

<header>
<h1>💻 RAM INFOTECH</h1>
<p>Your Trusted Laptop Sales & Service Center</p>
</header>

<nav>
<a href="#home">Home</a>
<a href="#store">Online Store</a>
<a href="#service">Service Center</a>
<a href="#about">About Us</a>
<a href="#contact">Contact</a>
</nav>

<div class="box" id="home">
<h2>Welcome to Ram Infotech</h2>
<p>Buy quality laptops and get reliable computer services.</p>
</div>

<div class="box" id="store">
<h2>Online Laptop Store</h2>
<div class="item">
<h3>HP Laptop</h3><p>8GB RAM | 512GB SSD</p>
<p>₹45,000</p><button onclick="buy('HP Laptop')">Buy Now</button>
</div>
<div class="item">
<h3>Dell Laptop</h3><p>16GB RAM | 512GB SSD</p>
<p>₹55,000</p><button onclick="buy('Dell Laptop')">Buy Now</button>
</div>
<div class="item">
<h3>Lenovo Laptop</h3><p>8GB RAM | 256GB SSD</p>
<p>₹40,000</p><button onclick="buy('Lenovo Laptop')">Buy Now</button>
</div>
</div>

<div class="box" id="service">
<h2>Service Center</h2>
<input id="customer" placeholder="Customer Name"><br>
<input id="issue" placeholder="Laptop Problem"><br>
<button onclick="service()">Book Repair</button>
<h3 id="result"></h3>
</div>

<div class="box" id="about">
<h2>About Us</h2>
<p>Ram Infotech provides quality laptops, affordable prices
and professional repair services to customers.</p>
</div>

<div class="box">
<h2>FAQ</h2>
<p>Q: Do you provide laptop repair? Yes.</p>
<p>Q: Can I purchase laptops online? Yes.</p>
<p>Q: Can I track service status? Contact our service center.</p>
</div>

<div class="box" id="contact">
<h2>Contact Us</h2>
<input placeholder="Your Name"><br>
<input placeholder="Email"><br>
<textarea placeholder="Your Message"></textarea><br>
<button onclick="alert('Message submitted successfully!')">Send Message</button>
</div>

<footer style="color:white;padding:15px">
© 2026 Ram Infotech | All Rights Reserved
</footer>

<script>
function buy(p){
alert(p+" selected successfully!");
}
function service(){
let n=document.getElementById("customer").value;
let i=document.getElementById("issue").value;
if(!n||!i){alert("Enter all details");return;}
document.getElementById("result").innerText=
"Service booked successfully for "+n+"!";
}
</script>

</body>
</html>
