
<!DOCTYPE html>
<html>
<head>
<title>ArtistryHub</title>
<style>
body{margin:0;font-family:Arial;background:linear-gradient(120deg,#42275a,#c471ed);text-align:center;color:#333}
header{background:#251337;color:white;padding:25px}
nav{background:#e9c6f5;padding:15px}
nav a{margin:15px;color:#42275a;text-decoration:none;font-weight:bold}
.box{background:white;width:80%;margin:25px auto;padding:20px;border-radius:18px}
.art{display:inline-block;background:#f5e9fa;padding:15px;margin:10px;border-radius:12px;width:180px}
.art img{width:160px;height:120px;object-fit:cover;border-radius:10px}
button{background:#8e44ad;color:white;padding:10px 18px;border:0;border-radius:6px;cursor:pointer}
input,textarea{padding:10px;margin:8px;border:1px solid #aaa;border-radius:6px}
footer{color:white;padding:15px}
</style>
</head>
<body>

<header>
<h1>🎨 ARTISTRYHUB</h1>
<p>Discover the Artistic World of Emily Harris</p>
</header>

<nav>
<a href="#home">Home</a>
<a href="#gallery">Gallery</a>
<a href="#bio">Biography</a>
<a href="#contact">Contact</a>
</nav>

<div class="box" id="home">
<h2>Welcome to My Art World</h2>
<p>Explore beautiful paintings and creative masterpieces.</p>
</div>

<div class="box" id="gallery">
<h2>My Art Gallery</h2>
<div class="art">
<img src="https://picsum.photos/200?1">
<h3>Nature Art</h3>
<button onclick="buy('Nature Art')">Buy Print</button>
</div>
<div class="art">
<img src="https://picsum.photos/200?2">
<h3>Abstract Art</h3>
<button onclick="buy('Abstract Art')">Buy Print</button>
</div>
<div class="art">
<img src="https://picsum.photos/200?3">
<h3>Modern Art</h3>
<button onclick="buy('Modern Art')">Buy Print</button>
</div>
</div>

<div class="box" id="bio">
<h2>About Emily Harris</h2>
<p>Emily Harris is a passionate artist known for creative paintings,
modern designs and beautiful exhibitions.</p>
<h3>Achievements</h3>
<p>Art Exhibitions | Painting Awards | Creative Projects</p>
</div>

<div class="box">
<h2>Latest Updates</h2>
<p>New artwork exhibition coming soon!</p>
</div>

<div class="box" id="contact">
<h2>Contact Emily</h2>
<input id="name" placeholder="Your Name"><br>
<input id="email" placeholder="Your Email"><br>
<textarea id="msg" placeholder="Your Message"></textarea><br>
<button onclick="send()">Send Message</button>
<h3 id="result"></h3>
</div>

<footer>© 2026 ArtistryHub | Emily Harris</footer>

<script>
function buy(item){
alert(item+" selected for purchase!");
}
function send(){
let n=document.getElementById("name").value;
let e=document.getElementById("email").value;
let m=document.getElementById("msg").value;
if(!n||!e||!m){alert("Fill all details");return;}
document.getElementById("result").innerText="Thank you "+n+"! Message sent.";
}
</script>

</body>
</html>
