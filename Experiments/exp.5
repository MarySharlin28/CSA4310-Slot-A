
<!DOCTYPE html>
<html>
<head>
<title>Flight Reservation</title>
<style>
body{text-align:center;font-family:Arial;background:#dceeff}
h1{background:navy;color:white;padding:20px}
.box{background:white;padding:15px;margin:20px auto;
width:80%;border-radius:12px;box-shadow:0 3px 8px #888}
input,select,button{padding:10px;margin:7px;border-radius:5px}
button{background:navy;color:white;border:0;cursor:pointer}
button:hover{background:orange}
</style>
</head>
<body>

<h1>✈ Flight Reservation System</h1>

<div class="box">
<h2>User Login</h2>
<input id="user" placeholder="Username">
<input id="pass" type="password" placeholder="Password">
<button onclick="alert('Login Successful')">Login</button>
</div>

<div class="box">
<h2>Search Flights</h2>
<input id="from" placeholder="From">
<input id="to" placeholder="Destination">
<input type="date" id="date">
<button onclick="search()">Search</button>
<p id="result"></p>
</div>

<div class="box">
<h2>Book Ticket</h2>
<select id="flight">
<option>Air India</option>
<option>IndiGo</option>
</select>
<input id="name" placeholder="Passenger Name">
<input id="seat" placeholder="Seat Number">
<button onclick="book()">Book Now</button>
<p id="ticket"></p>
</div>

<div class="box">
<h2>Admin Panel</h2>
<input id="admin" placeholder="Flight Name">
<button onclick="add()">Add Flight</button>
<p id="msg"></p>
</div>

<script>
function search(){
result.innerHTML="Flights from "+from.value+" to "+to.value;
}
function book(){
ticket.innerHTML="Ticket booked for "+name.value+
" | Seat: "+seat.value;
}
function add(){
msg.innerHTML=admin.value+" added successfully!";
}
</script>

</body>
</html>
